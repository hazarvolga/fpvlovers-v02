{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --import tsx scripts/db-migrate.ts && next start",
    "lint": "eslint src scripts --ext .ts,.tsx,.js,.mjs",
    "lint:ci": "eslint src scripts --ext .ts,.tsx,.js,.mjs --max-warnings=0",
    "lint:changed": "git diff --name-only --diff-filter=ACMR origin/main...HEAD -- '*.ts' '*.tsx' '*.js' '*.mjs' | xargs -r eslint --max-warnings=0",
    "clean": "next clean",
    "prepare": "husky install",
    "seeds:manifest": "python3 scripts/import-fpv-rag-seeds.py --mode manifest",
    "seeds:ingest": "python3 scripts/import-fpv-rag-seeds.py --mode ingest --limit 5",
    "seeds:queue": "python3 scripts/import-fpv-rag-seeds.py --mode queue",
    "seeds:backlog": "python3 scripts/import-fpv-rag-seeds.py --mode backlog",
    "seeds:backlog-pack": "python3 scripts/import-fpv-rag-seeds.py --mode backlog-pack --pack-limit 3",
    "seeds:deferred-pack": "python3 scripts/import-fpv-rag-seeds.py --mode deferred-pack --pack-limit 3",
    "handoff": "node scripts/generate-handoff.mjs",
    "handoff:test": "node scripts/handoff-regression-test.mjs",
    "opencode:brief": "node scripts/opencode-brief.mjs",
    "security:audit": "node scripts/repository-security-audit.mjs",
    "metadata:audit": "node --import tsx scripts/audit-content-metadata.ts",
    "metadata:test": "node --import tsx scripts/content-metadata-regression-test.ts",
    "seo:discoverability-test": "node --import tsx scripts/seo-discoverability-regression-test.ts",
    "metadata:migrate": "node --import tsx scripts/phase3-metadata-expansion.ts",
    "editorial:governance-test": "node --import tsx scripts/editorial-governance-regression-test.ts",
    "social:contracts-test": "node --import tsx scripts/social-video-contracts-regression-test.ts",
    "video:mvp:prepare": "node --import tsx scripts/prepare-video-mvp.ts",
    "video:mvp:render:fallback": "node scripts/render-video-mvp-fallback.mjs",
    "automation:status": "node --import tsx scripts/automation-status.ts --daily-target=4",
    "automation:backlog-audit": "node --import tsx scripts/automation-backlog-audit.ts --target=56 --daily-cron-runs=8",
    "automation:recover-stale": "node --import tsx scripts/automation-recover-stale-jobs.ts",
    "production:smoke": "node scripts/production-smoke.mjs",
    "production:shadow-parity": "node scripts/production-shadow-parity-audit.mjs",
    "commercial:readiness-test": "node --import tsx scripts/commercial-readiness-regression-test.ts",
    "affiliate:application-readiness": "node --import tsx scripts/affiliate-application-readiness-audit.ts",
    "quality:recent": "node scripts/recent-code-quality-audit.mjs",
    "content:smoke": "node --import tsx scripts/content-automation-smoke.ts",
    "content:cover-test": "node scripts/article-cover-fallback-regression-test.mjs",
    "content:language-audit": "node --import tsx scripts/content-language-audit.ts",
    "content:audit": "node --import tsx scripts/content-integrity-audit.ts",
    "content:topic-cover-test": "node --import tsx scripts/topic-fallback-cover-regression-test.ts",
    "public:editorial-test": "node --import tsx scripts/public-editorial-regression-test.ts",
    "crawl:worker-test": "node --import tsx scripts/crawl-worker-regression-test.ts",
    "crawl:retry-test": "node --import tsx scripts/crawl-retry-regression-test.ts",
    "crawl:health-test": "node --import tsx scripts/crawler-health-regression-test.ts",
    "content:repair": "node --import tsx scripts/repair-queue-status.ts",
    "tools:audit": "node --import tsx scripts/tool-truth-audit.ts",
    "tools:blackbox:test": "node --import tsx scripts/blackbox-regression-test.ts",
    "tools:blackbox:smoke": "node --import tsx scripts/blackbox-smoke.ts",
    "tools:blackbox:smoke:strict": "node --import tsx scripts/blackbox-smoke.ts --strict-contract",
    "tools:blackbox:smoke:real": "FORCE_REAL_LLM=true node --import tsx scripts/blackbox-smoke.ts",
    "tools:blackbox:sources": "node --import tsx scripts/blackbox-source-pack.ts",
    "tools:blackbox:enqueue": "node --import tsx scripts/blackbox-source-pack.ts --enqueue",
    "tools:part-matcher:test": "node --import tsx scripts/part-matcher-regression-test.ts",
    "tools:calculator:test": "node --import tsx scripts/build-calculator-regression-test.ts",
    "spec-trust:test": "node --import tsx scripts/spec-trust-regression-test.ts",
    "migration-runner:test": "node --import tsx scripts/migration-runner-regression-test.ts",
    "catalog:sources": "node --import tsx scripts/product-catalog-source-pack.ts",
    "catalog:affiliate-audit": "node --import tsx scripts/affiliate-catalog-audit.ts",
    "catalog:enqueue": "node --import tsx scripts/product-catalog-source-pack.ts --enqueue",
    "catalog:extract": "node --import tsx scripts/extract-product-catalog.ts",
    "racing:sources": "node --import tsx scripts/racing-source-pack.ts",
    "racing:enqueue": "node --import tsx scripts/racing-source-pack.ts --enqueue",
    "racing:crawl:status": "node --import tsx scripts/process-racing-crawl-queue.ts --status",
    "racing:crawl:process": "node --import tsx scripts/process-racing-crawl-queue.ts",
    "racing:intelligence:ingest": "node --import tsx scripts/racing-intelligence-ingest.ts",
    "racing:intelligence:status": "node --import tsx scripts/racing-intelligence-ingest.ts --status",
    "routes:audit": "node scripts/route-tree-drift-audit.mjs",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:backfill": "node --import tsx scripts/db-backfill-raw-content.ts",
    "db:backfill:published": "node --import tsx scripts/db-backfill-published-content.ts",
    "media:audit": "node --import tsx scripts/media-policy-audit.ts",
    "media:backfill-catalog": "node --import tsx scripts/backfill-catalog-media.ts",
    "db:inject-images": "node --import tsx scripts/db-inject-images-to-published.ts",
    "racing:workflow:smoke": "node --import tsx scripts/racing-workflow-smoke.ts",
    "content:job-selection-test": "node --import tsx scripts/content-job-selection-regression-test.ts"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.2",
    "@next/third-parties": "^16.2.9",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^6.10.1",
    "pg": "^8.21.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^15.0.0",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.22.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
