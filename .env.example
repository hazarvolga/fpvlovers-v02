NODE_ENV=production
APP_URL=https://fpvlovers.com.tr

ADMIN_USER=
ADMIN_PASS=

DIFY_BASE_URL=https://dify.affexai.tr/v1
DIFY_API_KEY=
DIFY_APP_KEY=

GEMINI_API_KEY=

GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

LLM_CACHE_ENABLED=true
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

CRAWL_DRY_RUN=false
CRAWL4AI_PRIMARY_HEALTH_URL=http://crawler-proxy:3002/health
CRAWL4AI_PRIMARY_CRAWL_URL=http://crawler-proxy:3002/crawl
CRAWL4AI_BACKUP_HEALTH_URL=http://crawler-backup:3002/health
CRAWL4AI_BACKUP_CRAWL_URL=http://crawler-backup:3002/crawl

# FPV Lovers App DB Migration Settings
FPV_DATABASE_URL=postgresql://user:pass@host:5432/db
FPV_STORAGE_MODE=files
FPV_DB_POOL_MAX=3

# SMTP Settings for Newsletter
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=newsletter@fpvlovers.com.tr

# Dify App Tokens (FPV Expert, Build Wizard, Part Matcher, Blackbox, Community)
DIFY_APP_TOKEN_EXPERT=
DIFY_APP_TOKEN_BUILD_WIZARD=
DIFY_APP_TOKEN_PART_MATCHER=
DIFY_APP_TOKEN_BLACKBOX=
DIFY_APP_TOKEN_COMMUNITY=

# Dify Workflow Tokens
DIFY_WORKFLOW_TOKEN_SEO=
DIFY_WORKFLOW_TOKEN_RACING=
DIFY_WORKFLOW_TOKEN_AFFILIATE=
DIFY_WORKFLOW_TOKEN_SPONSORSHIP=
DIFY_WORKFLOW_TOKEN_METADATA=
DIFY_WORKFLOW_TOKEN_PUBLISHER=
DIFY_WORKFLOW_TOKEN_PART_MATCHER=
DIFY_WORKFLOW_TOKEN_HD_TUNE=
