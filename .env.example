SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxxx"
SMTP_FROM_EMAIL="FPVLovers <newsletter@fpvlovers.com>"

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID="G-ZTMJYH67QW"
